 Teams.TeamEnum.TEN\n    ]\n\n    // \"warm\" teams rarely drop below 50\n    let warmTeams = [\n        Teams.TeamEnum.MIA, Teams.TeamEnum.LAC, Teams.TeamEnum.ARI,\n        Teams.TeamEnum.TB, Teams.TeamEnum.NO, Teams.TeamEnum.ATL,\n        Teams.TeamEnum.HOU, Teams.TeamEnum.LV\n    ]\n\n    export let CurrentTemp: number = null\n\n    let currentWeather: WeatherKinds = WeatherKinds.None\n    let isRunning: boolean = false\n\n    let snowIntervalId: number = null\n    let stormIntervalId: number = null\n\n    export function startWeather(kind: WeatherKinds) {\n        // FIRST, stop any existing weather\n        stopWeather()\n\n        currentWeather = kind\n        isRunning = true\n\n        if (currentWeather == weather.WeatherKinds.Snow) {\n            timer.background(function () {\n                let tempImage = _field.image.clone()\n                for (let i = 0; i < 1000; i++) {\n                    let randomX = Math.randomRange(0, tempImage.width)\n                    let randomY = Math.randomRange(0, tempImage.height)\n                    tempImage.setPixel(randomX, randomY, 1)\n                }\n                snowFieldImage = tempImage  // Store the modified CLONE\n            })\n\n            // Use a background loop instead of onUpdateInterval\n            timer.background(function () {\n                while (isRunning && currentWeather == weather.WeatherKinds.Snow) {\n                    if (replaying) {\n                        pause(800)\n                        continue\n                    }\n\n                    for (let i = 0; i < Math.randomRange(10, 30); i++) {\n                        let snowflake = sprites.create(assets.image`snowflake`, SpriteKind.Snowflake)\n                        snowflake.x = Math.randomRange(-200, 300)\n                        snowflake.y = 16\n                        snowflake.z = 30\n                        snowflake.setScale(1 + (Math.randomRange(1, 3) / 10), ScaleAnchor.Middle)\n                        snowflake.vy = 10\n\n                        timer.background(function () {\n                            let randomY = Math.randomRange(30, 103)\n                            pauseUntil(() => snowflake.y > randomY)\n                            snowflake.z = _field.z + 1\n                            snowflake.vy = 0\n                            pause(1000)\n                            sprites.destroy(snowflake)\n                        })\n                    }\n                    pause(800)\n                }\n            })\n\n        } else if (currentWeather == weather.WeatherKinds.Storm) {\n            // Similar fix for storm\n            timer.background(function () {\n                let tempImage = _field.image.clone()\n                for (let i = 0; i < 1000; i++) {\n                    let randomX = Math.randomRange(0, tempImage.width)\n                    let randomY = Math.randomRange(0 + 2, tempImage.height - 2)\n                    tempImage.setPixel(randomX, randomY, 14)\n                }\n                stormFieldImage = tempImage  // Store the modified CLONE\n            })\n\n            timer.background(function () {\n                while (isRunning && currentWeather == weather.WeatherKinds.Storm) {\n                    if (replaying) {\n                        pause(100)\n                        continue\n                    }\n\n                    timer.background(function () {\n                        if (Math.percentChance(1)) {\n                            let lightning = sprites.create(assets.image`lightning`, SpriteKind.Lightning)\n                            music.play(music.melodyPlayable(music.bigCrash), music.PlaybackMode.UntilDone)\n                            color.startFade(color.White, color.originalPalette, 100)\n\n                            let target = screenToWorld(Math.randomRange(20, 140), 85)\n                            lightning.setPosition(target.x, target.y)\n                            lightning.y = 48\n             