lean {\n        // TODO: Return if weather system is currently active\n        return isRunning\n    }\n\n    export function transitionTo(kind: WeatherKinds, duration: number) {\n        // TODO: Smooth transition between weather types\n    }\n\n    export function isSnowTeam(team: Teams.TeamEnum): boolean {\n        return snowTeams.indexOf(team) !== -1\n    }\n\n    export function isStormTeam(team: Teams.TeamEnum): boolean {\n        return stormTeams.indexOf(team) !== -1\n    }\n\n    export function isWarmTeam(team: Teams.TeamEnum): boolean {\n        return warmTeams.indexOf(team) !== -1\n    }\n\n    export function isColdTeam(team: Teams.TeamEnum): boolean {\n        return coldTeams.indexOf(team) !== -1\n    }\n\n    export function generateGameTemp(homeTeam: Teams.TeamEnum) {\n        let baseMin = 50\n        let baseMax = 80\n        let week = CurrentWeek // 1–17\n\n        // Early-season boost for warm teams\n        let earlySeasonBoost = (week <= 4 && warmTeams.indexOf(homeTeam) >= 0) ? 5 : 0\n\n        let minTemp = Math.floor(baseMin - week * 1.5 + randint(-2, 2) + earlySeasonBoost)\n        let maxTemp = Math.floor(baseMax - week * 1.5 + randint(-2, 2) + earlySeasonBoost)\n\n        // clamp values to realistic range\n        minTemp = Math.max(20, Math.min(99, minTemp))\n        maxTemp = Math.max(20, Math.min(99, maxTemp))\n\n        if (coldTeams.indexOf(homeTeam) >= 0) {\n            minTemp -= 10\n            maxTemp -= 10\n        } else if (warmTeams.indexOf(homeTeam) >= 0) {\n            minTemp = Math.max(minTemp, 55)\n            maxTemp = Math.max(maxTemp, 70)\n        }\n\n        // ensure minTemp is not higher than maxTemp\n        if (minTemp > maxTemp) {\n            minTemp = maxTemp\n        }\n\n        let gameTemp = randint(minTemp, maxTemp)\n        CurrentTemp = gameTemp\n    }\n\n    export function getWeatherText(): string {\n        if (currentWeather == WeatherKinds.None) {\n            return \"Clear skies\"\n        } else if (currentWeather == WeatherKinds.Snow) {\n            return CurrentTemp <= 32 ? \"Snowing\" : \"Flurries\"\n        } else if (currentWeather == WeatherKinds.Storm) {\n            return \"Stormy\"\n        } else {\n            return \"Unknown\"\n        }\n    }\n\n}\n\nfunction screenToWorld(screenX: number, screenY: number): { x: number, y: number } {\n    const camX = scene.cameraProperty(CameraProperty.X)\n    const camY = scene.cameraProperty(CameraProperty.Y)\n    const worldX = camX - scene.screenWidth() / 2 + screenX\n    const worldY = camY - scene.screenHeight() / 2 + screenY\n    return { x: worldX, y: worldY }\n}\n\ngame.onUpdate(function () {\n    if (Score) {\n        fancyText.setText(Score, \"\" + Teams.getTeamProperty(CurrentAwayTeam, Teams.TeamProperty.TeamAbbreviation) + \" \" + AwayScore + \"-\" + HomeScore + \" \" + Teams.getTeamProperty(CurrentHomeTeam, Teams.TeamProperty.TeamAbbreviation))\n    }\n    if (qtrClock) {\n        fancyText.setText(qtrClock, secondsToMs(gameClock))\n        if (gameClock < 60 && gameClock > 10) {\n            fancyText.setColor(qtrClock, 5)\n        } else if (gameClock < 11) {\n            fancyText.setColor(qtrClock, 2)\n        } else {\n            fancyText.setColor(qtrClock, 1)\n        }\n    }\n    if (qtrText) {\n        fancyText.setText(qtrText, \"Q\" + _quarter)\n    }\n})\ngame.onUpdate(function () {\n    if (!(onField)) {\n        for (let value122 of sprites.allOfKind(SpriteKind.NonPlayerPlayers)) {\n            value122.setFlag(SpriteFlag.Invisible, true)\n        }\n    } else {\n        for (let value13 of sprites.allOfKind(SpriteKind.NonPlayerPlayers)) {\n            value13.setFlag(SpriteFlag.Invisible, false)\n        }\n    }\n})\ngame.onUpdate(function () {\n    if (sprites.allOfKind(SpriteKind.Field).length > 0) {\n        if (CameraX > -74 && CameraX < 239) {\n            lerpCameraX(CameraX)\n        }\n    } else {\n        scene.centerCameraAt(80, 60)\n    }\n})\ngame.onUpda